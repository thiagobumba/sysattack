<?xml version="1.0" encoding="UTF-8"?>
<!-- Cookie de sessão: HttpOnly e SameSite=Lax (o navegador não o envia em requisições originadas em outros sites) -->
<Context useHttpOnly="true">
  <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" sameSiteCookies="lax"/>
</Context>
